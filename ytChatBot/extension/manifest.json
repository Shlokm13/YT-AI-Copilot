{
  "manifest_version": 3,

  "name": "YT AI Copilot",

  "version": "1.0",

  "description": "AI-powered YouTube assistant",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.vercel.app/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://*.vercel.app"
  }
}